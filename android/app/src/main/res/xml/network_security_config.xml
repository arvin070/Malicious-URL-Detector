<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted ONLY for the local development server addresses a
  prototype is pointed at (the emulator's host alias and localhost). Everything
  else must be HTTPS, which is what a real deployment would use for the API.
  A blanket android:usesCleartextTraffic="true" would have been easier and would
  have allowed the token to travel in plaintext to any host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
