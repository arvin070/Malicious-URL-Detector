<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Profile" android:textSize="20sp" android:textStyle="bold"/>
    <TextView android:id="@+id/p_account" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:fontFamily="monospace"
        android:textSize="13sp" android:paddingTop="8dp" android:paddingBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Security preferences" android:textSize="16sp" android:textStyle="bold"/>
    <Switch android:id="@+id/p_warn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Check links I tap"/>
    <Switch android:id="@+id/p_dns" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Hostname-based DNS layer"/>
    <Button android:id="@+id/p_clear_trusted" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Clear trusted sites"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingTop="18dp" android:text="Detection model" android:textSize="16sp"
        android:textStyle="bold"/>
    <TextView android:id="@+id/p_model" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="12sp"/>

    <TextView android:id="@+id/p_privacy" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="18dp" android:textSize="12sp"/>

    <Button android:id="@+id/p_signout" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Sign out"/>
  </LinearLayout>
</ScrollView>
